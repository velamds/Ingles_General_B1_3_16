 1, "_data": [{"content": "", "type": "text"}]}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "engenn8le16ob09re7pdf01.pdf", "type": "pdf"}]}]}], "stimuli_ids": [], "id": 11, "template_override": 1}], "type": "scholar", "stimuli": [{"id": 0, "template_override": 1, "_data": [], "type": "welcome", "contents": [{}]}, {"type": "audio", "_data": [], "id": 1, "template_override": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "image": "engenn8le16ob09re2img01.jpg", "time": "0", "id": 0}, {"text": "<span class=\"strong\">Vanessa</span>:  I have another offbeat story. I heard it at a barbecue on Memorial Day from a friend of a friend, so it might not be that reliable.<br/>\n<span class=\"strong\">Sally</span>:  Yes, friends of friends always have the best, unreliable stories.<br/>\n<span class=\"strong\">Vanessa</span>:  Anyway, this story happened in Florida a couple of years ago. One summer, there was a rash of break in, but these weren&rsquo;t ordinary burglars. These burglars would break into people&rsquo;s homes when they were on vacation, at sports events, festivals ...<br/>\n<span class=\"strong\">Sally</span>:  Wait! How did they know these people weren&rsquo;t at home?<br/>\n<span class=\"strong\">Vanessa</span>:  I guess they scouted out the homes and watched them, but that&rsquo;s not the crazy part.", "image": "engenn8le16ob09re2img01.jpg", "time": "100", "id": 1}, {"text": "<span class=\"strong\">Sally</span>:  Ok.<br/>\n<span class=\"strong\">Vanessa</span>:  Apparently, they didn&rsquo;t steal anything. These burglars just redecorated the homes.<br/>\n<span class=\"strong\">Sally</span>:  What? They redecorated the homes?<br/>\n<span class=\"strong\">Vanessa</span>:  According to the story, they also painted the walls and moved around furniture.<br/>\n<span class=\"strong\">Sally</span>:  So, what did they steal?<br/>\n<span class=\"strong\">Vanessa</span>:  They stole all the food in the house and then left.<br/>\n<span class=\"strong\">Sally</span>:  They didn&rsquo;t steal anything else?<br/>\n<span class=\"strong\">Vanessa</span>:  I guess not.", "image": "engenn8le16ob09re2img02.jpg", "time": "36300", "id": 2}, {"text": "<span class=\"strong\">Sally</span>:  Hmmm. I want to believe that story, but ...<br/>\n<span class=\"strong\">Vanessa</span>: Yeah, I know. So do I. But my friends say that story is not made up.<br/>\n<span class=\"strong\">Sally</span>:  It sounds made up. I just don&rsquo;t believe that happened.<br/>\n<span class=\"strong\">Vanessa</span>:  Actually, now that I tell it again, neither do I.<br/>\n<span class=\"strong\">Sally</span>:  Yeah, I&rsquo;m definitely thinking your friend of a friend is not a reliable source. <br/><span class=\"strong\">Vanessa</span>:  So am I. Well, this is what Google is for Sally.", "image": "engenn8le16ob09re2img05.jpg", "time": "62300", "id": 3}], "coverimg": "engenn8le16ob09re2img01.jpg", "audiosrc": "engenn8le16ob09re2aud01"}, "type": "slideshow"}]}]}], "_data": [{"type": "metadata", "contents": [{"content": "Strange Coincidences", "type": "lesson_name"}, {"content": "No Way, Jose!", "type": "unit_name"}, {"content": 9, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 16, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe unusual events in the past through a wider range of B1 language in both work and social contexts.", "type": "primary"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"content": "engenn8le16ob09re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Simple Past", "type": "heading"}, {"content": "You use the Simple Past tense to talk about many kinds of past events: short, quickly finished actions, longer situations and repeated events. ", "type": "describer"}, {"content": "Usually, when you use the Simple Past tense, the time of the finished action is clear from the context or explicitly mentioned in the sentence.", "type": "text"}, {"content": "For example:<br/><span class=\"italic\">Burglars <span class=\"strong\">robbed</span> the house when they were on vacation.</span>", "type": "text"}, {"content": "Here is another example:<br/><span class=\"italic\">Last summer, they <span class=\"strong\">redecorated</span> their house.</span>", "type": "text"}, {"content": "Remember that there are both regular and irregular verbs. Look at the chart for examples of the Simple Past tense verbs.", "type": "text"}, {"content": "<span class=\"strong\">Regular Verbs</span>:", "type": "text"}, {"content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Present\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Past\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"discover\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"discovered\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"recognize\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"recognized\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "<span class=\"strong\">Irregular Verbs</span>:", "type": "text"}, {"content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Present\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Past\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"think\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"thought\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"know\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"knew\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "They redecorated the homes?", "type": "example"}, {"content": "So, what did they steal?", "type": "example"}, {"content": "They stole all the food in the house and then left.", "type": "example"}, {"content": "They didn't steal anything else?", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "The Position of Not", "type": "heading"}, {"content": "When you want to emphasize that something or an action is opposite to what is expected, use <span class=\"italic\">not</span>, rather than a contraction in the sentence.", "type": "describer"}, {"content": "It might not be that reliable.", "type": "example"}, {"content": "I'm definitely thinking your friend of a friend is not a reliable source. ", "type": "example"}, {"content": "But my friends say that story is not made-up.", "type": "example"}, {"content": "<span class=\"strong\">Lucy</span>: I just don't believe that happened. <span class=\"strong\">Frank</span>: Actually, now that I tell it again, neither do I.", "type": "example"}, {"content": "For example: <span class=\"italic\">They say the storyteller is not reliable. The article's writer is not truthful.</span>", "type": "text"}, {"content": "The <span class=\"strong\">not</span> shows a firmness on the part of the speaker while still being polite.", "type": "text"}, {"content": "{\"rows\":5,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Statement\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">They say they are not the most reliable people.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"They shouldn't be trusted.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">They say it's not true.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It is false.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">My friends say that story is not made-up.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The story is not false.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">We did not, thank goodness.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"We're happy we didn't do it.\\\"}\"],\"styles\":\" instruction_table_background\"}", "type": "table"}, {"content": "SO is used to show agreement with positive statements:<br/><span class=\"strong\">SO + Auxiliary/Be + Subject (pronoun)</span><br/><br/>It is similar to using <span class=\"strong\">too</span> at the end of a sentence.", "type": "text"}, {"content": "{\"rows\":1,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><span class=\\\"strong\\\">Frank</span>: I am happy.<br/> <span class=\\\"strong\\\">Lucy</span>: <span class=\\\"strong\\\">So am I</span>  (I am happy too)</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><span class=\\\"strong\\\">Frank</span>: I think the story is untrue. <br/> <span class=\\\"strong\\\">Lucy</span>: <span class=\\\"strong\\\">So do I</span>  (I think the story is false too)</span>\\\"}\"],\"styles\":\"\"}", "type": "table"}, {"content": "Neither is used to show agreement with negative statements.<br/><span class=\"strong\">Neither + Auxiliary + Subject (pronoun)</span><br/><br/>The Auxiliary needs to agree with the verb tense in the original statement.", "type": "text"}, {"content": "It is similar to using <span class=\"strong\">either</span> at the end of a sentence, although <span class=\"strong\">neither</span> is more commonly used, especially in spoken English.<br><span class=\"italic\"><span class=\"strong\">Frank</span>: I don't believe that story.<br/><span class=\"strong\">Lucy</span>: Neither do I. (= I don't believe it either.)</span>", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "offbeat", "type": "name"}, {"content": "not usual", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I have another offbeat story.", "type": "example"}, {"content": "engenn8le16ob09aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use when you tell an odd story.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to break in", "type": "name"}, {"content": "to make a way through", "type": "definition"}, {"content": "(phrasal verb)", "type": "part_speech"}, {"content": "Example: These weren't ordinary burglars that broke in to the houses.", "type": "example"}, {"content": "engenn8le16ob09aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to scout out", "type": "name"}, {"content": "to try to find something", "type": "definition"}, {"content": "(phrasal verb)", "type": "part_speech"}, {"content": "Example: I guess they scouted out the homes and watched them, but that's not the crazy part.", "type": "example"}, {"content": "engenn8le16ob09aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to redecorate", "type": "name"}, {"content": "to paint a room or put new objects in it", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example:  Apparently, they didn't steal anything. These burglars  just redecorated the homes.", "type": "example"}, {"content": "engenn8le16ob09aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "friend of a friend", "type": "name"}, {"content": "someone that you know; an acquaintance ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I'm definitely thinking your friend of a friend is not a reliable source. ", "type": "example"}, {"content": "engenn8le16ob09aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "reliable", "type": "name"}, {"content": "able to be trusted", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I'm definitely thinking your friend of a friend is not a reliable source. ", "type": "example"}, {"content": "engenn8le16ob09aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to make up", "type": "name"}, {"content": "to invent a story", "type": "definition"}, {"content": "(phrasal verb)", "type": "part_speech"}, {"content": "Example: But my friends say that story is not made up.", "type": "example"}, {"content": "engenn8le16ob09aud07", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Write three strange short stories about yourself and your past experiences. The stories should only be a couple of sentences long.", "type": "text"}, {"content": "The stories can be true or false.", "type": "text"}, {"content": "Read one story to the group.", "type": "text"}, {"content": "Have the group comment on whether they think it is true or false.", "type": "text"}, {"content": "Heave each person in the group share their story.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about coincidences and strange events.", "type": "text"}, {"content": "I react and comment on a story.", "type": "text"}, {"content": "I write about past events.", "type": "text"}]}], "type": "sena"}