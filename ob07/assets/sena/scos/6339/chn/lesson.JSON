n", "contents": [{"content": "engenn8le16ob07re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": " Talk about past experiences and past events!", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Writing", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self Assessment.", "type": "text"}]}], "id": 11, "type": "DWS"}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "type": "scholar", "id": 0, "stimuli": [{"template_override": 1, "_data": [], "contents": [{}], "id": 0, "type": "welcome"}, {"type": "audio", "template_override": 1, "title": "", "_data": [], "contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le16ob07re2img05.jpg", "audiosrc": "engenn8le16ob07re2aud01", "images": [{"time": "0", "image": "engenn8le16ob07re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le16ob07re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Sally</span>:  V. You are hilarious. Marco. I haven&rsquo;t heard that name in a while.<br/>\n<span class=\"strong\">Vanessa</span>:  Hmm. Oh by the way, Did you hear the news about the bank robbery yesterday?<br/>\n<span class=\"strong\">Sally</span>:  No, What happened?<br/>\n<span class=\"strong\">Vanessa</span>:  You won&rsquo;t believe it, a man walked into a bank downtown and gave the bank teller a note. According to the news, the note said, &ldquo;I have a bomb, fill the bag with cash.&rdquo;<br/>\n<span class=\"strong\">Sally</span>:  Wow. That is nuts. Was anybody hurt in the robbery?<br/>\n<span class=\"strong\">Vanessa</span>:  Nobody knew about it. The teller filled the bag with money. I guess he stole something like ten thousand dollars in cash and ran out the door."}, {"time": "32750", "image": "engenn8le16ob07re2img01.jpg", "id": 2, "text": "<span class=\"strong\">Sally</span>:  So he got away?<br/>\n<span class=\"strong\">Vanessa</span>:  No, five minutes later the man came back to the bank, put the bag on the counter, apologized to the teller and then waited for the police.<br/>\n<span class=\"strong\">Sally</span>:  The remorseful bankrobber.<br/>\n<span class=\"strong\">Vanessa</span>:  &nbsp;Have you ever heard a story that crazy before?<br/>\n<span class=\"strong\">Sally</span>:  Well, There was the freeway sign accident story. Have you heard that one?<br/>\n<span class=\"strong\">Vanessa</span>:  &nbsp;Oh right! Yeah. I did. I have heard a lot of strange stories, but that was the strangest."}, {"time": "58500", "image": "engenn8le16ob07re2img05.jpg", "id": 3, "text": "<span class=\"strong\">Sally</span>:  Is it me, or have there been a lot of bizarre stories in the news lately?<br/>\n<span class=\"strong\">Vanessa</span>:  There has been a few.<br/>\n<span class=\"strong\">Sally</span>:  Maybe I should blog about all the ridiculous stories I have heard recently.<br/>\n<span class=\"strong\">Vanessa</span>:  Why not? That topic sounds as good as any. I know a lot of strange and unusual stories I can tell you.<br/>\n<span class=\"strong\">Sally</span>:  Oooo. I can&rsquo;t wait."}]}}], "id": 1}, {"template_override": 1, "title": "", "contents": [{"type": "p", "value": "On Saturday I went to the mall and experienced the strangest thing ever. I was in a grocery store when the security alarm went off. Everyone was confused because there was someone by the exit door and he wouldn't move. When the security guard went to talk to him, he realized it was a little boy who had stolen a candy bar and was crying because he was remorseful. It was the weirdest thing because of all the chaos, just for a candy bar."}], "_data": [], "id": 2, "type": "static"}]}], "type": "sena"}