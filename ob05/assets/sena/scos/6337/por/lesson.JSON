ntent": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "type": "RSLT"}, {"questions": [{"responses": [{"correct": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "id": 0}], "_data": [{"type": "question", "contents": [{"content": "engenn8le16ob05re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": " Role play a dining situation.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Speaking", "type": "skill"}, {"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self Assessment.", "type": "text"}]}], "id": 11, "type": "DWS"}], "_data": [{"contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}], "type": "lab_options"}], "type": "scholar", "stimuli": [{"_data": [], "contents": [{}], "template_override": 1, "type": "welcome", "id": 0}, {"type": "audio", "template_override": 1, "title": "", "_data": [], "id": 1, "contents": [{"type": "slideshow", "value": {"coverimg": "engenn8le16ob05re2img01.jpg", "audiosrc": "engenn8le16ob05re2aud01", "images": [{"time": "0", "image": "engenn8le16ob05re2img01.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn8le16ob05re2img01.jpg", "id": 1, "text": "<span class=\"strong\">Sally</span>:  Hey. V. Come in. I&rsquo;m supposed to be writing, but I am feeling lazy.<br/>\n<span class=\"strong\">Vanessa</span>:  Good, because I have a story for you.<br/>\n<span class=\"strong\">Sally</span>:  Oh. Ok. Shoot!<br/>\n<span class=\"strong\">Vanessa</span>:  Well, It was nine-thirty on Monday night. We are supposed to close at ten, but the place was dead. The servers were sent home early and the kitchen was closed.<br/>\n<span class=\"strong\">Sally</span>:  Have you ever closed up early before?<br/>\n<span class=\"strong\">Vanessa</span>:  Sure, sometimes. This older gentlemen comes into the restaurant, from out of the blue, and asks if he could see a menu. I say, &ldquo;sorry, but the kitchen is closed for tonight&rdquo;.<br/>\nHe says, &ldquo;is there anything because I am really hungry?&rdquo; I say, &ldquo;I am not supposed to do this, but I will look.&rdquo; The only thing we had was soup and bread. The soup was whipped up &nbsp;by the chef and I served it to the man and told him to take his time because it is not too late."}, {"time": "51000", "image": "engenn8le16ob05re2img02.jpg", "id": 2, "text": "<span class=\"strong\">Sally</span>:  Have you ever done this before?<br/>\n<span class=\"strong\">Vanessa</span>:  No. So, the man eats slowly and when he finished, it is after ten. &nbsp;I gave him the bill and took his dishes and when I came back, he was gone.<br/>\n<span class=\"strong\">Sally</span>:  Oh no. Did he not pay?<br/>"}, {"time": "66750", "image": "engenn8le16ob05re2img05.jpg", "id": 3, "text": "<span class=\"strong\">Vanessa</span>:  I thought so. &nbsp;I have had customers dine and dash. Then, I looked down and saw a five hundred dollar tip and a note saying, &ldquo;thank you&rdquo;.<br/>\n<span class=\"strong\">Sally</span>:  Wow! That was not what I was expecting. &nbsp;Have you ever had a tip that big before?<br/>\n<span class=\"strong\">Vanessa</span>:  Haha. yes.<br/>\n<span class=\"strong\">Sally</span>:  What did you do with the money?<br/>\n<span class=\"strong\">Vanessa</span>:  It was given to the staff.<br/>\n<span class=\"strong\">Sally</span>:  You are a good boss.<br/>\n<span class=\"strong\">Vanessa</span>:  It is what you are supposed to do.<br/>"}]}}]}], "id": 0}], "type": "sena"}