"were", "type": "text"}], "selected": 0}], "id": 1, "_data": [{"type": "question", "contents": [{"content": "The fans", "type": "text"}]}, {"type": "post_question", "contents": {"content": "rolled out the red carpet for their actress.", "type": ""}}, {"content": "secondary_8", "type": "objective"}]}, {"responses": [{"id": 0, "correct": 0, "_data": [{"content": "is", "type": "text"}], "selected": 0}, {"id": 1, "text": "", "correct": 1, "_data": [{"content": "has", "type": "text"}], "selected": 0}, {"id": 2, "text": "", "correct": 0, "_data": [{"content": "was", "type": "text"}], "selected": 0}], "id": 2, "_data": [{"type": "question", "contents": [{"content": "Jim", "type": "text"}]}, {"type": "post_question", "contents": {"content": "ruined the party.", "type": ""}}, {"content": "secondary_8", "type": "objective"}]}], "stimuli_ids": [], "id": 9, "template_override": 1}, {"type": "RSLT", "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "questions": [{"responses": [{"id": 0, "correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}]}], "stimuli_ids": [], "id": 10, "template_override": 1}, {"type": "DWS", "_data": [{"type": "instructions", "contents": [{"content": " That is an amazing coincidence!", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Reading", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self Assessment.", "type": "text"}]}], "questions": [{"responses": [{"id": 0, "correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "engenn8le16ob02re7pdf01.pdf", "type": "pdf"}]}]}], "stimuli_ids": [], "id": 11, "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"id": 0, "template_override": 1, "type": "welcome", "_data": [], "contents": [{}]}, {"type": "audio", "_data": [], "title": "", "template_override": 1, "id": 1, "contents": [{"value": {"images": [{"text": "", "image": "engenn8le16ob02re2img01.jpg", "time": "0", "id": 0}, {"text": "<span class=\"strong\">Sally</span>:  Oh Peter, what a misunderstanding. I have never heard a story that crazy before and Peter, it is not your fault.<br/>\n<span class=\"strong\">Peter</span>:  Really?<br/>\n<span class=\"strong\">Sally</span>:  No, it is your fault! Peter!<br/>\n<span class=\"strong\">Peter</span>:  Well, that&rsquo;s not the end of the story. My wallet was stolen also.<br/>\n<span class=\"strong\">Sally</span>:  Where? At the party?<br/>\n<span class=\"strong\">Peter</span>:  Probably.<br/>\n<span class=\"strong\">Sally</span>:  &nbsp;Well. You should not expect them to roll out the red carpet for you.<br/>", "image": "engenn8le16ob02re2img01.jpg", "time": "100", "id": 1}, {"text": "<span class=\"strong\">Peter</span>:  What should I do?<br/>\n<span class=\"strong\">Sally</span>:  You need to go back and get your wallet.<br/>\n<span class=\"strong\">Peter</span>:  They&rsquo;ll be furious. I ruined the party.<br/>\n<span class=\"strong\">Sally</span>:  I doubt it! &nbsp;I&rsquo;m sure they will not hold this against you.<br/>\n<span class=\"strong\">Peter</span>:  I&rsquo;m really embarrassed though. I have never felt this embarrassed before and what if he wants to fight? I have never been in a fight. Have you ever been in a fight?<br/>\n<span class=\"strong\">Sally</span>:  Oh Peter. I&rsquo;ll go get your wallet.<br/>\n<span class=\"strong\">Peter</span>:  What? No, ... could you?<br/>\n<span class=\"strong\">Sally</span>:  Yes, I owe you.<br/>\n<span class=\"strong\">Peter</span>:  Thank you. Do you want me to come?<br/>", "image": "engenn8le16ob02re2img05.jpg", "time": "20000", "id": 2}, {"text": "<span class=\"strong\">Sally</span>:  No wait here. I will not be long.<br/>\n<span class=\"strong\">Peter</span>:  Oh my God. What did they say?<br/>\n<span class=\"strong\">Sally</span>:  There was a guy there named Mitch. He was nice. Your wallet was found last night. &nbsp;It wasn&rsquo;t stolen. It was found lying on the floor by one of the guests. It was put in a drawer for safekeeping. &nbsp;He also said you will not have to worry about him being angry either.<br/>\n<span class=\"strong\">Peter</span>:  Really? Oh Sally, How can I thank you?<br/>\n<span class=\"strong\">Sally</span>:  Peter. You already have, but today, you can buy me lunch? <br/>", "image": "engenn8le16ob02re2img05.jpg", "time": "45500", "id": 3}], "coverimg": "engenn8le16ob02re2img01.jpg", "audiosrc": "engenn8le16ob02re2aud01"}, "type": "slideshow"}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "Strange Coincidences", "type": "lesson_name"}, {"content": "Can You Believe It?", "type": "unit_name"}, {"content": 2, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 16, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe  unusual events through a wider range of B1 language in both work and social contexts.", "type": "primary"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"content": "engenn8le16ob02re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "The Passive Voice", "type": "heading"}, {"content": "You use the active voice when you want the \u2018doer' of the action to be the subject.<br/><br/>You use the passive voice when you want the \u2018receiver' of the action to be the subject.", "type": "describer"}, {"content": "Active sentence = TV (subject) <span class=\"strong\">influences</span> children's behavior (object).", "type": "text"}, {"content": "Passive sentence = Children's behavior (subject) <span class=\"strong\">is influenced</span> by TV (object).", "type": "text"}, {"content": "It is not always necessary to mention the object in a passive sentence. ", "type": "text"}, {"content": "You make the passive form of a verb by using tenses of the <span class=\"italic\">be</span> verb followed by the past participle. ", "type": "text"}, {"content": "The Simple Present passive form is:", "type": "text"}, {"content": "am/are/is + past participle", "type": "text"}, {"content": "For example:<ul><lu><span class=\"italic\">My wallet was stolen.</span></li></ul>", "type": "text"}, {"content": "The Simple Past passive form is:", "type": "text"}, {"content": "was/were + past participle", "type": "text"}, {"content": "For example:<ul><li><span class=\"italic\">Your wallet was found on the floor by the door.</span></li></ul>", "type": "text"}, {"content": "My wallet was stolen.", "type": "example"}, {"content": "Your wallet was found that night.  ", "type": "example"}, {"content": "It wasn't stolen.", "type": "example"}, {"content": " It was found lying on the floor by one of the guests.", "type": "example"}, {"content": " It was put in a drawer for safekeeping.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Position of not", "type": "heading"}, {"content": "When you want to emphasize that something or an action is opposite to what is expected, use not, rather than a contraction in the sentence.<br/><br/>For example:<br/>They say they will <span class=\"strong\">not</span> be angry at you.<br/>They will <span class=\"strong\">not</span> hold this against you.<br/><br/>The <span class=\"strong\">not</span> shows a firmness on the part of the speaker while still being polite.", "type": "describer"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Statement\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Meaning\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">They say they are not inviting you to another party. <br/><br/>They say they are not angry with you.<br/><br/>I did not, thank goodness. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"They refuse to invite you to another party.<br/><br/>They are not angry.<br/><br/>I'm happy I didn't do something.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "He also said you will not have to worry about him being angry either.", "type": "example"}, {"content": "I'm sure they will not hold this against you.", "type": "example"}, {"content": "You should not expect them to roll out the red carpet for you.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "misunderstanding", "type": "name"}, {"content": "a minor problem caused by someone who misunderstood a situation", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Oh, what a misunderstanding. I've never heard a story that crazy!", "type": "example"}, {"content": "engenn8le16ob02aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use when you can't believe something.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "roll out the red carpet", "type": "name"}, {"content": "to give a person a very special treatment", "type": "definition"}, {"content": "(idiom)", "type": "part_speech"}, {"content": "Example: You should not expect them to roll out the red carpet for you.", "type": "example"}, {"content": "engenn8le16ob02aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "furious", "type": "name"}, {"content": "very angry", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I ruined their party. They'll be furious!", "type": "example"}, {"content": "engenn8le16ob02aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "I doubt it", "type": "name"}, {"content": "if you doubt something, you are not certain about it", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: <br/><span class=\"strong\">Peter</span>: They'll be furious.<br/> <span class=\"strong\">Sally</span>: I doubt it.", "type": "example"}, {"content": "engenn8le16ob02aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "hold something against you", "type": "name"}, {"content": "to think badly of something or someone because of something else; to blame something on someone", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I'm sure they will not hold this against you.", "type": "example"}, {"content": "engenn8le16ob02aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to ruin", "type": "name"}, {"content": "to harm or damage irreparably", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I ruined their party.", "type": "example"}, {"content": "engenn8le16ob02aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "safe keeping", "type": "name"}, {"content": "the fact of something being in a place where it will not be lost or damaged", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Your wallet was put in a drawer for safe keeping.", "type": "example"}, {"content": "engenn8le16ob02aud07", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "With a partner research an amazing or bizarre coincidence on the internet.", "type": "text"}, {"content": "Write a short presentation for each using your own words.", "type": "text"}, {"content": "Break up the partners and put them in small groups with other classmates.", "type": "text"}, {"content": "Go around the group presenting your story.", "type": "text"}, {"content": "After, vote on which story was the most interesting and prepare to explain why.", "type": "text"}, {"content": "Write a short paragraph sharing one of your most amazing or bizarre       experiences.", "type": "text"}, {"content": "Later share with your group.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I  talk about coincidences and strange events.", "type": "text"}, {"content": "I  react and comment on a story. ", "type": "text"}, {"content": "I  discuss experiences I have and haven't had. ", "type": "text"}]}]}