elected": 0}], "id": 2, "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}, {"type": "post_question", "contents": {"content": "an animal costume this year. </br><span class=\"run-on-question\"></span> They", "type": ""}}, {"content": "secondary_8", "type": "objective"}]}, {"responses": [{"id": 0, "correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "didn't know", "type": "text"}], "selected": 0}], "id": 3, "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}, {"type": "post_question", "contents": {"content": "it was a sixties party.", "type": ""}}, {"content": "secondary_8", "type": "objective"}]}], "stimuli_ids": [], "id": 9, "template_override": 2}, {"type": "RSLT", "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "questions": [{"responses": [{"id": 0, "correct": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"id": 1, "correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}]}], "stimuli_ids": [], "id": 10, "template_override": 1}, {"type": "DWS", "_data": [{"type": "instructions", "contents": [{"content": " Tell me more information!", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self Assessment.", "type": "text"}]}], "questions": [{"responses": [{"id": 0, "correct": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "engenn8le16ob01re7pdf01.pdf", "type": "pdf"}]}]}], "stimuli_ids": [], "id": 11, "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"id": 0, "template_override": 1, "_data": [], "type": "welcome", "contents": [{}]}, {"type": "audio", "_data": [], "id": 1, "template_override": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "image": "engenn8le16ob01re2img05.jpg", "time": "0", "id": 0}, {"text": "<span class=\"strong\">Sally</span>: So, how was your Saturday? What did you do? Where did you go?<br/>\n<span class=\"strong\">Peter</span>: Well, my Saturday was eventful.<br/>\n<span class=\"strong\">Sally</span>: Why?<br/>\n<span class=\"strong\">Peter</span>: Have you ever been to a costume party before?<br/>\n<span class=\"strong\">Sally</span>: Ummm. yes!<br/>\n<span class=\"strong\">Peter</span>: Well, not like this. An acquaintance at the comic book store invited me to a house party. His name is Mitch. Have you ever met Mitch?<br/>", "image": "engenn8le16ob01re2img05.jpg", "time": "100", "id": 1}, {"text": "<span class=\"strong\">Sally</span>: No. So, what happened?<br/>\n<span class=\"strong\">Peter</span>: I went over to the house at 145 Center Street, and loud music was playing and there was a sign on the door that said, &ldquo;Come In&rdquo;. So I did.<br/>\n<span class=\"strong\">Sally</span>: Strange. Have you ever seen anything like that?<br/>", "image": "engenn8le16ob01re2img05.jpg", "time": "19250", "id": 2}, {"text": "<span class=\"strong\">Peter</span>: No. I went inside and there were lots of people dressed in animal costumes with huge animal heads. &nbsp;They were making crazy animal sounds and jumping around. I asked a monkey if he knew Mitch? &nbsp;He pointed to a large cow.<br/>\nI went up to the cow and the cow started to head butt me.<br/>\n<span class=\"strong\">Sally</span>: What?<br/>", "image": "engenn8le16ob01re2img01.jpg", "time": "33200", "id": 3}], "coverimg": "engenn8le16ob01re2img05.jpg", "audiosrc": "engenn8le16ob01re2aud01"}, "type": "slideshow"}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "Strange Coincidences", "type": "lesson_name"}, {"content": "I Heard a Funny Story", "type": "unit_name"}, {"content": 1, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 16, "type": "lesson"}, {"content": "B1.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe unusual events in the past through a wider range of B1 language in both work and social contexts.", "type": "primary"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_1"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_2"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_3"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_4"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_5"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_6"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_7"}, {"content": "Understands important and specific information and aspects in conversations, texts or presentations about the communicative functions related to this level. ", "type": "secondary_8"}]}, {"content": "engenn8le16ob01re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "Simple Past", "type": "heading"}, {"content": "You use the Simple Past tense to talk about many kinds of past events: short, quickly finished actions, longer situations and repeated events. ", "type": "describer"}, {"content": "Usually, when you use the Simple Past tense, the time of the finished action is clear from the context or explicitly mentioned in the sentence.", "type": "text"}, {"content": "For example:", "type": "text"}, {"content": "<span class=\"italic\">How was your Saturday?</span>", "type": "text"}, {"content": "Here, it is clear when the action of \u201crecognizing\u201d happened (on Saturday night) and that it finished in that time period. ", "type": "text"}, {"content": "Here is another example:", "type": "text"}, {"content": "<span class=\"italic\"> I went over to the house.</span>", "type": "text"}, {"content": "Remember that there are both regular and irregular verbs. Look at the chart for examples of the Simple Past tense verbs.", "type": "text"}, {"content": "<span class=\"strong\">Regular Verbs</span>:", "type": "text"}, {"content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Present\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Past\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"discover\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"discovered\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"recognize\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"recognized\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}, {"content": "<span class=\"strong\">Irregular Verbs</span>:", "type": "text"}, {"content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Present\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Past\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"go\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"went\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"know\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"knew\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}, {"content": "I checked the address on my phone again. ", "type": "example"}, {"content": "It was another Mitch.", "type": "example"}, {"content": "I went over to the house.", "type": "example"}, {"content": "What did you do? ", "type": "example"}, {"content": "Where did you go?", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Present Perfect", "type": "heading"}, {"content": "You use the Present Perfect tense to talk about a past action or an action that began in the past that is connected to the present in some way. ", "type": "describer"}, {"content": "You can use the Present Perfect tense to talk about experience.<br/>When you use the Present Perfect tense, you think about the past and present together. There is some connection between what happened in the past and now. ", "type": "text"}, {"content": "For example: <br/>I have learned English = I learned English in the past and now I can speak English.<br/>He has bought a painting = He bought the painting in the past and now he has a painting. ", "type": "text"}, {"content": "<span class=\"italic\"><ul><li>Have you ever met Mitch?</li><li>Have you been to a costume party?</li></ul></span>", "type": "text"}, {"content": "Have you ever seen something like that?", "type": "example"}, {"content": "Have you ever been to a costume party?", "type": "example"}, {"content": "Has something like that ever happened to you?", "type": "example"}, {"content": "I have never been to a costume party.", "type": "example"}, {"content": "I have never seen anything like that before.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "eventful", "type": "name"}, {"content": "full of important or intriguing events", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: My Saturday was eventful, it really amazed me!", "type": "example"}, {"content": "engenn8le16ob01aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about funny stories.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "acquaintance", "type": "name"}, {"content": "somebody you know who is not a close friend", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: An acquaintance at the comic book store invited me to a house party.", "type": "example"}, {"content": "engenn8le16ob01aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to head butt", "type": "name"}, {"content": "to hit with horns, especially by animals", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I went to the cow and it started to head butt me. ", "type": "example"}, {"content": "engenn8le16ob01aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to twist", "type": "name"}, {"content": "to bend or turn something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I grabbed his horns and twisted and his head came off!", "type": "example"}, {"content": "engenn8le16ob01aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to gasp", "type": "name"}, {"content": "to breathe in suddenly, especially in surprise or pain ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: His head came off. Everyone gasped ... ", "type": "example"}, {"content": "engenn8le16ob01aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to ram", "type": "name"}, {"content": "to run into something or somebody very hard", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: When he tried to ram me again, I grabbed his horns.", "type": "example"}, {"content": "engenn8le16ob01aud06", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Students create 8 \u2018have you ever' questions about life experiences.", "type": "text"}, {"content": "In groups, students take turns asking each other their questions.", "type": "text"}, {"content": "If a student answers yes to any of the \u2018have you ever' questions, follow up with \u2018Wh' questions looking for more details.", "type": "text"}, {"content": "After students are to write a 3 sentences about things they have done which they don't think anyone else in the class has done, and something they have never done, but they think someone in the class has.", "type": "text"}, {"content": "Share your sentences with the class and check if your sentences are right.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about strange events.", "type": "text"}, {"content": "I discuss experiences I have and haven't had. ", "type": "text"}, {"content": "I talk about past events.", "type": "text"}]}]}