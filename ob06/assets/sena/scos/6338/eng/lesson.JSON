: 10, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"id": 0, "selected": 0, "correct": 0, "_data": [{"content": "", "type": "text"}]}, {"id": 1, "selected": 0, "correct": 1, "_data": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"type": "learning_skills", "contents": []}], "type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn8le16ob06re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "selected": 0, "correct": 1, "_data": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " That is a crazy sounding diet!", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Writing", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn8le16ob06re2img05.jpg"}, {"text": "<span class=\"strong\">Sally</span>:  What a great story, but I have a question for you? Have you ever been on a diet?<br/>\n<span class=\"strong\">Vanessa</span>:  Of course. It&rsquo;s a tradition in my family for the women to battle their weight. Why do you ask?<br/>\n<span class=\"strong\">Sally</span>:  I am supposed to revisit my blog about healthy eating, but this time I&rsquo;m going to talk about diet trends.<br/>\n<span class=\"strong\">Vanessa</span>:  Cool. What about cleanses? Have you done any research on them?<br/>\n<span class=\"strong\">Sally</span>:  No. I haven&rsquo;t. I don&rsquo;t know anything about them. Have you ever been on a cleanse?<br/>\n<span class=\"strong\">Vanessa</span>:  Oh yeah. Two years ago. I was going on the annual family trip to Mexico and I wanted to look good for the beach. Have you ever been to Cancun?<br/>\n<span class=\"strong\">Sally</span>:  No.", "id": 1, "time": "100", "image": "engenn8le16ob06re2img05.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>:  It&rsquo;s amazing. Anyway, I wanted to lose weight. So, I went on the Lemon Cleanse.<br/>\n<span class=\"strong\">Sally</span>:  What&rsquo;s that?<br/>\n<span class=\"strong\">Vanessa</span>:  Oh. It&rsquo;s all the rage. You are supposed to drink a concoction of lemon juice, honey, and cayenne pepper and you are not supposed to drink or eat anything else.<br/>\n<span class=\"strong\">Sally</span>:  What? That&rsquo;s insane! Only that?<br/>\n<span class=\"strong\">Vanessa</span>:  Yes. I carried around a bottle of the mixture and drank from it all day.<br/>\n<span class=\"strong\">Sally</span>:  How long did you do it for?<br/>\n<span class=\"strong\">Vanessa</span>:  Two weeks. I managed to lose fifteen pounds.", "id": 2, "time": "34950", "image": "engenn8le16ob06re2img02.jpg"}, {"text": "<span class=\"strong\">Sally</span>:  Oh my God! &nbsp;V! Have you ever lost that much weight before that quickly?<br/>\n<span class=\"strong\">Vanessa</span>:  No. I was supposed to lose more! I felt pretty weak when I was in Mexico, but boy did I look good.<br/>\n<span class=\"strong\">Sally</span>:  That&rsquo;s crazy.<br/>\n<span class=\"strong\">Vanessa</span>:  Well. It was just mind over matter.<br/>\n<span class=\"strong\">Sally</span>:  Haha. What about now?<br/>\n<span class=\"strong\">Vanessa</span>:  Ahhh. Well. I work in a restaurant so I don&rsquo;t mind and now that Marco is gone, it doesn&rsquo;t matter.", "id": 3, "time": "61900", "image": "engenn8le16ob06re2img01.jpg"}], "audiosrc": "engenn8le16ob06re2aud01", "coverimg": "engenn8le16ob06re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}